---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PhilosophyCards from '../components/PhilosophyCards.astro';
import Button from '../components/Button.astro';
import PixelIcon from '../components/icons/PixelIcon.astro';
import { emberMap, palettes } from '../components/icons/pixel-maps';
import studioScene from '../assets/scenes/studio.png';

const approach = [
  {
    title: 'Start small',
    text: 'We begin with one core idea and a tiny playable version, then let the game show us where it wants to grow.',
  },
  {
    title: 'Play it, then change it',
    text: 'Ideas are cheap until they are played. We test early and often, and we are happy to cut what does not earn its place.',
  },
  {
    title: 'Respect the player',
    text: 'Clear rules, fair challenge and a world that is pleasant to spend time in. Your time is valuable, so the game should be worth it.',
  },
];
---

<BaseLayout
  title="Studio"
  description="Emberwick Games is a small independent studio. Read how we approach development and game design."
>
  <PageIntro eyebrow="The studio" title="A little spark can build a world.">
    <p>
      Emberwick Games is a small, independent game studio. We like games that fit in a few minutes yet stay with
      you for much longer, and that is what we try to make.
    </p>
  </PageIntro>

  <section class="section studio-story" aria-labelledby="approach-title">
    <div class="container studio-story__grid">
      <div class="studio-story__art frame" data-reveal>
        <Picture
          src={studioScene}
          alt="Pixel-art studio at night: a developer works on a laptop beside a crackling fireplace, a cat resting nearby."
          formats={['avif', 'webp']}
          sizes="(min-width: 900px) 50vw, 100vw"
        />
      </div>
      <div data-reveal style="--reveal-delay: 0.1s">
        <p class="eyebrow">How we work</p>
        <h2 id="approach-title">Our approach to development</h2>
        <ol class="approach">
          {
            approach.map((step, i) => (
              <li>
                <span class="approach__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <PhilosophyCards />

  <section class="section studio-cta" aria-labelledby="studio-cta-title">
    <div class="container studio-cta__inner" data-reveal>
      <PixelIcon map={emberMap} palette={palettes.ember} size={48} />
      <div>
        <h2 id="studio-cta-title">Say hello</h2>
        <p class="muted">Feedback, questions and ideas are always welcome.</p>
      </div>
      <Button href="/contact">Contact Us</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .studio-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .studio-story__art :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 40% 50%;
  }

  .approach {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .approach li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
  }

  .approach__num {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    color: var(--ember);
    padding-top: 0.2rem;
  }

  .approach h3 {
    margin-bottom: 0.5rem;
  }

  .approach p {
    margin: 0;
    color: var(--muted);
  }

  .studio-cta {
    padding-top: 0;
  }

  .studio-cta__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .studio-cta__inner > div {
    flex: 1;
  }

  .studio-cta__inner h2 {
    margin-bottom: 0.5rem;
  }

  .studio-cta__inner p {
    margin: 0;
  }

  @media (max-width: 899px) {
    .studio-story__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .studio-cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
