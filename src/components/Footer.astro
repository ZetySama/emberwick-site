---
import { Picture } from 'astro:assets';
import Logo from './Logo.astro';
import SocialIcon from './icons/SocialIcon.astro';
import Sparks from './motion/Sparks.astro';
import footerScene from '../assets/scenes/footer.jpg';
import { activeSocials, site } from '../config/site';

const year = new Date().getFullYear();
const links = [
  { href: '/games', label: 'Games' },
  { href: '/studio', label: 'Studio' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy/dice-merge', label: 'Privacy Policy' },
];
---

<footer class="site-footer">
  <div class="site-footer__scene" aria-hidden="true">
    <Picture
      src={footerScene}
      alt=""
      formats={['avif', 'webp']}
      loading="lazy"
    />
    <Sparks count={10} rise="260px" class="site-footer__sparks" />
  </div>

  <div class="container site-footer__inner">
    <a href="/" class="site-footer__brand" aria-label="Emberwick Games, home">
      <Logo />
    </a>

    <nav aria-label="Footer">
      <ul class="site-footer__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="site-footer__social" aria-label="Contact and social">
      {
        activeSocials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
              <SocialIcon name={s.key} />
            </a>
          </li>
        ))
      }
      <li>
        <a href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>
          <SocialIcon name="mail" />
        </a>
      </li>
    </ul>
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} Emberwick Games</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: auto;
    background: var(--bg);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .site-footer__scene {
    position: relative;
    height: clamp(150px, 23vw, 340px);
    overflow: hidden;
  }

  .site-footer__scene :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 52%;
  }

  .site-footer__scene::before,
  .site-footer__scene::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .site-footer__scene::before {
    background: linear-gradient(180deg, var(--bg) 0%, rgba(16, 18, 26, 0) 35%);
    z-index: 1;
  }

  .site-footer__scene::after {
    background: linear-gradient(0deg, var(--bg) 0%, rgba(16, 18, 26, 0) 42%);
    z-index: 1;
  }

  .site-footer__scene :global(.site-footer__sparks) {
    z-index: 2;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    padding-block: 1.5rem 2rem;
    border-bottom: 1px solid var(--line);
  }

  .site-footer__brand {
    display: inline-flex;
    border-radius: 6px;
  }

  .site-footer__links,
  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__links {
    gap: 0.25rem 1.75rem;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--cream);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--ember);
  }

  .site-footer__social {
    gap: 0.5rem;
  }

  .site-footer__social a {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--cream);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .site-footer__social a:hover {
    color: var(--ember);
    border-color: rgba(255, 129, 69, 0.5);
    background: rgba(255, 129, 69, 0.08);
  }

  .site-footer__bottom {
    padding-block: 1.25rem 2rem;
    font-size: 0.875rem;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  @media (max-width: 767px) {
    .site-footer__scene :global(.site-footer__sparks) {
    z-index: 2;
  }

  .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-footer__links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 1.5rem;
      width: 100%;
    }
  }
</style>
