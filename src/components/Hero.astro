---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import heroScene from '../assets/scenes/hero.png';

// A handful of embers rising from the campfire (left, value = % of hero width; d = duration; s = delay).
const sparks = [
  { left: 27, d: 7.5, s: 0 },
  { left: 29, d: 9, s: 2.4 },
  { left: 31, d: 8, s: 4.1 },
  { left: 33, d: 10, s: 1.2 },
  { left: 35, d: 8.5, s: 5.6 },
  { left: 30, d: 11, s: 6.8 },
  { left: 34, d: 9.5, s: 3.3 },
  { left: 32, d: 7, s: 7.9 },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" data-parallax aria-hidden="true">
    <Picture
      src={heroScene}
      alt=""
      formats={['avif', 'webp']}
      priority
      class="hero__img"
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__sparks" aria-hidden="true">
    {sparks.map((s) => <span style={`--x:${s.left}%;--d:${s.d}s;--s:${s.s}s`}></span>)}
  </div>

  <div class="container hero__content">
    <p class="eyebrow hero__eyebrow">Emberwick Games</p>
    <h1 id="hero-title" class="hero__title">Small worlds.<br /> Lasting adventures.</h1>
    <p class="hero__text">
      We craft thoughtful games with distinctive worlds, satisfying mechanics, and a spark of wonder.
    </p>
    <div class="hero__actions">
      <Button href="/games">Explore Our Games</Button>
      <Button href="/studio" variant="outline">Discover the Studio</Button>
    </div>
  </div>

  <a href="#studio" class="hero__scroll" aria-label="Scroll to the studio introduction">
    <span aria-hidden="true"></span>
  </a>
</section>

<script>
  const layer = document.querySelector<HTMLElement>('[data-parallax]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (layer) {
    let ticking = false;
    const update = () => {
      ticking = false;
      if (reduce.matches) {
        layer.style.transform = '';
        return;
      }
      const y = Math.min(window.scrollY, window.innerHeight);
      layer.style.transform = `translate3d(0, ${y * 0.25}px, 0)`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 100svh;
    margin-top: calc(-1 * var(--header-h));
    padding-block: calc(var(--header-h) + 3rem) 6rem;
    overflow: hidden;
    background: #0b0f1f;
  }

  .hero__bg {
    position: absolute;
    inset: -2% 0 0;
    z-index: -3;
    will-change: transform;
  }

  .hero__bg :global(.hero__img),
  .hero__bg :global(picture) {
    width: 100%;
    height: 100%;
  }

  .hero__bg :global(.hero__img) {
    object-fit: cover;
    object-position: 50% 70%;
    image-rendering: auto;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 60% 55% at 50% 42%, rgba(10, 12, 22, 0.72), rgba(10, 12, 22, 0) 70%),
      linear-gradient(180deg, rgba(16, 18, 26, 0.55) 0%, rgba(16, 18, 26, 0) 22%),
      linear-gradient(0deg, var(--bg) 0%, rgba(16, 18, 26, 0) 28%);
  }

  .hero__sparks {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__sparks span {
    position: absolute;
    left: var(--x);
    bottom: 16%;
    width: 3px;
    height: 3px;
    background: var(--ember);
    box-shadow: 0 0 6px 1px rgba(255, 129, 69, 0.6);
    opacity: 0;
    animation: rise var(--d) linear var(--s) infinite;
  }

  .hero__sparks span:nth-child(3n) {
    background: var(--gold);
    width: 2px;
    height: 2px;
  }

  @keyframes rise {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    10% {
      opacity: 0.9;
    }
    50% {
      transform: translate(14px, -28vh);
    }
    80% {
      opacity: 0.4;
    }
    100% {
      transform: translate(-6px, -52vh);
      opacity: 0;
    }
  }

  .hero__content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__eyebrow {
    color: var(--gold);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .hero__title {
    font-size: clamp(1.35rem, 0.9rem + 2.6vw, 3rem);
    line-height: 1.5;
    margin-bottom: 1.5rem;
    color: var(--cream);
    text-shadow:
      0 3px 0 rgba(0, 0, 0, 0.55),
      0 0 30px rgba(10, 12, 22, 0.9);
  }

  .hero__text {
    max-width: 38rem;
    font-size: clamp(1.05rem, 0.98rem + 0.4vw, 1.25rem);
    color: var(--cream);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
    margin-bottom: 2.25rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }

  .hero__scroll span {
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--cream);
    border-bottom: 2px solid var(--cream);
    transform: rotate(45deg);
    opacity: 0.7;
    animation: nudge 2.4s var(--ease) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(-3px) rotate(45deg);
    }
    50% {
      transform: translateY(3px) rotate(45deg);
    }
  }

  @media (max-width: 767px) {
    .hero {
      align-items: flex-end;
      padding-bottom: 5.5rem;
    }

    /* Scene sits in the upper part so the campfire stays visible above the text */
    .hero {
      --scene-h: calc(var(--header-h) + 50svh);
      display: block;
      min-height: 100svh;
      padding-top: calc(var(--header-h) + 43svh);
      padding-bottom: 4rem;
      background: var(--bg);
    }

    .hero__bg,
    .hero__shade,
    .hero__sparks {
      inset: 0 0 auto 0;
      height: var(--scene-h);
    }

    .hero__bg :global(.hero__img) {
      object-position: 25% 92%;
    }

    .hero__shade {
      background:
        linear-gradient(180deg, rgba(16, 18, 26, 0.55) 0%, rgba(16, 18, 26, 0) 25%),
        linear-gradient(0deg, var(--bg) 0%, rgba(16, 18, 26, 0.6) 14%, rgba(16, 18, 26, 0) 32%);
    }

    .hero__scroll {
      display: none;
    }

    .hero__sparks span {
      left: calc(50% + (var(--x) - 31%) * 3);
      bottom: 20%;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 22rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__sparks {
      display: none;
    }

    .hero__bg {
      will-change: auto;
    }
  }
</style>
