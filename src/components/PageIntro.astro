---
// Shared heading block for inner pages.
import Sparks from './motion/Sparks.astro';
import FloatingDice from './motion/FloatingDice.astro';

interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
}

const { eyebrow, title, id = 'page-title' } = Astro.props;
---

<header class="page-intro">
  <div class="page-intro__glow" aria-hidden="true"></div>
  <FloatingDice />
  <Sparks count={9} rise="320px" />
  <div class="container page-intro__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 id={id}>{title}</h1>
    <div class="page-intro__lead"><slot /></div>
  </div>
</header>

<style>
  .page-intro {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .page-intro__glow {
    position: absolute;
    left: -10%;
    top: -60%;
    width: 70%;
    aspect-ratio: 1.4;
    background: radial-gradient(ellipse, rgba(255, 129, 69, 0.1), rgba(255, 129, 69, 0) 65%);
    pointer-events: none;
  }

  .page-intro__inner {
    position: relative;
    z-index: 1;
  }

  .page-intro__lead :global(p) {
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    color: var(--muted);
    max-width: 60ch;
    margin: 0;
  }
</style>
