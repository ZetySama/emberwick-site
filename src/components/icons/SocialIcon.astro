---
import type { SocialKey } from '../../config/site';

interface Props {
  name: SocialKey | 'mail';
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'x' && <path d="M4 4l16 16M20 4L4 20" />}
  {
    name === 'youtube' && (
      <>
        <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" />
        <path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'discord' && (
      <>
        <path d="M7 6.5c1.6-.8 3.2-1 5-1s3.4.2 5 1c1.7 2.4 2.6 5.2 2.5 8.7-1.4 1.1-3 1.9-4.6 2.3l-1-1.8c-1.2.3-2.6.3-3.8 0l-1 1.8c-1.6-.4-3.2-1.2-4.6-2.3C4.4 11.7 5.3 8.9 7 6.5z" />
        <circle cx="9.3" cy="12" r="1.2" fill="currentColor" stroke="none" />
        <circle cx="14.7" cy="12" r="1.2" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5.5" width="18" height="13" rx="2" />
        <path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
      </>
    )
  }
</svg>
