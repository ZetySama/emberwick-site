---
import Button from './Button.astro';
import PixelIcon from './icons/PixelIcon.astro';
import { emberMap, palettes } from './icons/pixel-maps';
---

<section class="section cta" aria-labelledby="cta-title">
  <div class="cta__glow" aria-hidden="true"></div>
  <div class="container cta__inner" data-reveal>
    <div class="cta__ember" aria-hidden="true">
      <PixelIcon map={emberMap} palette={palettes.ember} size={64} />
    </div>
    <h2 id="cta-title">Every great adventure starts somewhere.</h2>
    <p class="lead">Ours starts with a handful of dice. Come take a look.</p>
    <div class="cta__actions">
      <Button href="/games">Explore Our Games</Button>
      <Button href="/contact" variant="outline">Get in Touch</Button>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .cta__glow {
    position: absolute;
    left: 50%;
    bottom: -40%;
    width: min(1100px, 140vw);
    aspect-ratio: 1.6;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at 50% 60%,
      rgba(255, 129, 69, 0.22) 0%,
      rgba(239, 199, 121, 0.08) 35%,
      rgba(16, 18, 26, 0) 65%
    );
    pointer-events: none;
    animation: breathe 7s ease-in-out infinite;
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 1;
    }
  }

  .cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta__ember {
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 0 14px rgba(255, 129, 69, 0.45));
  }

  .cta h2 {
    max-width: 24ch;
  }

  .cta .lead {
    margin-bottom: 2rem;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  @media (max-width: 479px) {
    .cta__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 22rem;
    }
  }
</style>
